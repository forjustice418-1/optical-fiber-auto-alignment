<?xml version="1.0" ?>
<sdf version="1.7">

  <model name="xyz_stage">
    <static>true</static>

    <link name="base">

      <collision name="base_collision">
        <geometry>
          <box>
            <size>1 1 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>1 1 0.2</size>
          </box>
        </geometry>

        <material>
          <ambient>0 0 1 1</ambient>
        </material>

      </visual>

    </link>


    <link name="tx_fiber">

      <pose>0 0 0.5 0 0 0</pose>

      <collision name="tx_collision">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="tx_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>1 0 0 1</ambient>
        </material>

      </visual>

    </link>


    <link name="rx_fiber">

      <pose>0.4 0.2 0.5 0 0 0</pose>

      <collision name="rx_collision">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="rx_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>1 1 0 1</ambient>
        </material>

      </visual>

    </link>

  </model>

</sdf>
