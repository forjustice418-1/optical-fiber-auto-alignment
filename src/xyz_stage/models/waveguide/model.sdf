<?xml version="1.0" ?>
<sdf version="1.7">

  <model name="waveguide">

    <static>true</static>

    <link name="guide">

      <pose>0.15 0 0.08 0 0 0</pose>

      <visual name="visual">

        <geometry>
          <sphere>
            <radius>0.03</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0 1 0 1</ambient>
        </material>

      </visual>

    </link>

  </model>

</sdf>
